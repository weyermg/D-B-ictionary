<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:D_B_ictionary"
        x:Class="D_B_ictionary.AddWordWindow"
        x:DataType="vm:AddWordDialogViewModel"
        x:CompileBindings="True"
        Title="Add word"
        Width="480"
        Height="620"
        MinWidth="420"
        MinHeight="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#F2F6F3">
  <Grid Margin="28" RowDefinitions="*,Auto">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <TextBlock Text="Add word"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#1E3025"
                   Margin="0,0,0,10" />

        <TextBlock Text="Word" />
        <TextBox Text="{Binding Word, Mode=TwoWay}"
                 PlaceholderText="cat" />

        <TextBlock Text="Language code" />
        <TextBox Text="{Binding Language, Mode=TwoWay}"
                 PlaceholderText="en" />

        <TextBlock Text="Etymology index" />
        <TextBox Text="{Binding EtymologyIndex, Mode=TwoWay}"
                 PlaceholderText="1" />

        <TextBlock Text="Definition index" />
        <TextBox Text="{Binding DefinitionIndex, Mode=TwoWay}"
                 PlaceholderText="1" />

        <TextBlock Text="Definitions, one per line" />
        <TextBox Text="{Binding Definitions, Mode=TwoWay}"
                 PlaceholderText="A small domesticated feline."
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="110"
                 VerticalContentAlignment="Top" />

        <TextBlock Text="{Binding ValidationMessage}"
                   IsVisible="{Binding IsValidationMessageVisible}"
                   Foreground="#A63D35"
                   Margin="0,4,0,0" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10"
                Margin="0,20,0,0">
      <Button Content="Cancel"
              Command="{Binding CancelCommand}"
              Padding="16,8" />
      <Button Content="Add word"
              Command="{Binding AddCommand}"
              IsDefault="True"
              Padding="16,8" />
    </StackPanel>
  </Grid>
</Window>