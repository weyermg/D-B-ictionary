<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:D_B_ictionary"
        x:Class="D_B_ictionary.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="D(B)ictionary"
        Width="860"
        Height="680"
        MinWidth="420"
        MinHeight="360"
        Background="#F2F6F3">
  <Grid Margin="32" RowDefinitions="Auto,*">
    <Border Background="#FFFFFF"
            BorderBrush="#D5E0D9"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,4">
      <TextBox Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="Search words and definitions"
               FontSize="18"
               Background="Transparent"
               BorderThickness="0"
               VerticalContentAlignment="Center" />
    </Border>

    <Grid Grid.Row="1" Margin="0,20,0,0" RowDefinitions="Auto,*">
      <TextBlock Text="{Binding Message}"
                 IsVisible="{Binding IsMessageVisible}"
                 Foreground="#52655A"
                 Margin="2,0,0,12" />
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SearchResultViewModel">
              <Border Padding="4,16"
                      BorderBrush="#DCE5DF"
                      BorderThickness="0,0,0,1">
                <StackPanel Spacing="6">
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Language}"
                               Foreground="#607368"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Word}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E3025" />
                  </DockPanel>
                  <TextBlock Text="{Binding Definition}"
                             TextWrapping="Wrap"
                             Foreground="#405148"
                             LineHeight="22" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>